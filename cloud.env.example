# Optional settings for an existing Supabase account backend.
# The current desktop release uses CloudBase; these values are not needed
# for its email sign-in or AI trial. See supabase/README.md.
# Copy to .env (ignored by Git) only when configuring a Supabase backend.
WHO_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
WHO_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
